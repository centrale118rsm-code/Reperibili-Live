$candidate = @((Join-Path $env:LOCALAPPDATA 'ReperibiliLive'), (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'ReperibiliLive'), (Join-Path $env:USERPROFILE 'ReperibiliLive'))
$ico = $null
foreach($c in $candidate){
  try {
    New-Item -ItemType Directory -Force -Path $c | Out-Null
    $f = Join-Path $c 'turni-118.ico'
    [IO.File]::WriteAllBytes($f, [Convert]::FromBase64String($ico64))
    $ico = $f; break
  } catch { Write-Host ("  Cartella non permessa: " + $c) }
}
if(-not $ico){ Write-Host '  Non riesco a salvare l''icona: le scorciatoie avranno l''icona del browser.' }
$desk = [Environment]::GetFolderPath('Desktop')
$fatte = 0
foreach($i in $Icone){
  $f = Join-Path $desk ($i.Nome + '.url')
  $t = "[InternetShortcut]`r`nURL=" + $i.Url + "`r`n"
  if($ico){ $t += "IconFile=" + $ico + "`r`nIconIndex=0`r`n" }
  try { [IO.File]::WriteAllText($f, $t, [Text.Encoding]::Default); $fatte++; Write-Host ("  Creata: " + $i.Nome) }
  catch { Write-Host ("  Non riesco a creare " + $i.Nome + ": " + $_.Exception.Message) }
}
if($fatte -eq 0){ exit 3 }
exit 0
