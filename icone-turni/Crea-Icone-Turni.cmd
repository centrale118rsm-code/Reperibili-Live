@echo off
setlocal
set "SELF=%~f0"
if "%SELF:~0,2%"=="\\" goto :rete
title Reperibili Live - icone dei turni
rem  Crea sul desktop le scorciatoie "Turni Autisti" e "Turni Infermieri" con il logo 118.
set "RL_SRC=%~f0"
echo.
echo  Creo le icone dei turni sul desktop...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$t=[IO.File]::ReadAllText($env:RL_SRC,[Text.Encoding]::UTF8); $m=[char]10+':::'+'SCRIPT:::'; $i=$t.LastIndexOf($m); if($i -lt 0){exit 2}; iex $t.Substring($i+$m.Length)"
if errorlevel 1 (
  echo.
  echo  Non e' stato possibile creare le icone: mandami le righe qui sopra.
  echo.
  pause & exit /b 1
)
echo.
echo  Fatto. Sul desktop trovi "Turni Autisti" e "Turni Infermieri".
echo  Trascinale nello spazio libero in basso a sinistra del pannello dei reperibili.
echo  Se tornano al loro posto da sole: tasto destro sul desktop, Visualizza,
echo  togli la spunta a "Disponi icone automaticamente".
echo.
pause
exit /b 0
:rete
rem  Lanciato da una cartella di rete: da li' il PC non permette di avviare PowerShell.
set "LOC=%LOCALAPPDATA%\ReperibiliLive"
if not exist "%LOC%" mkdir "%LOC%"
copy /Y "%~f0" "%LOC%\%~nx0" >nul
echo.
echo  Questo file si trova in una cartella di rete: da li' il PC non lo lascia partire.
echo  L'ho copiato in una cartella del computer, che si apre adesso:
echo  fai doppio clic su %~nx0 da quella cartella.
echo.
explorer /select,"%LOC%\%~nx0"
pause
exit /b 0
:::SCRIPT:::
